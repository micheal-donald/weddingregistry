# ============================================================
# Wedding Registry — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Auth ─────────────────────────────────────────────────────
# Secret for signing JWT tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string

# ── M-Pesa STK Push (Lipa na M-Pesa Online) ─────────────────
# Get these from the Safaricom Developer Portal: https://developer.safaricom.co.ke
#
# Environment: sandbox (for testing) or production
MPESA_ENVIRONMENT=sandbox

# From your app on developer.safaricom.co.ke → Keys tab
MPESA_CONSUMER_KEY=your-consumer-key-here
MPESA_CONSUMER_SECRET=your-consumer-secret-here

# Your Paybill shortcode (use 174379 for sandbox testing)
MPESA_SHORTCODE=174379

# Passkey provided with your Paybill (use sandbox passkey for testing)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public URL where M-Pesa will POST payment results.
# For local dev, use ngrok: ngrok http 3001 → https://xxxx.ngrok.io
# Then set: https://xxxx.ngrok.io/api/webhooks/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/webhooks/mpesa/callback

# Optional: separate URL for timeout notifications (defaults to MPESA_CALLBACK_URL)
MPESA_TIMEOUT_URL=https://your-domain.vercel.app/api/webhooks/mpesa/timeout

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
